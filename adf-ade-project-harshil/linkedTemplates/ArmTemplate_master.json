{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ade-project-harshil"
		},
		"LS_parquet_Sqlserver_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_parquet_Sqlserver'"
		},
		"LS_ADB_dev_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0919-131200-05rhg1i0"
		},
		"LS_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-ade-project-harshil1.vault.azure.net/"
		},
		"LS_onpremsqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-G9IMRMTT"
		},
		"LS_onpremsqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"LS_onpremsqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "hpt"
		},
		"LS_parquet_Sqlserver_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsadeprojectdev.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ade-project-harshil_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_parquet_Sqlserver_accountKey": {
						"value": "[parameters('LS_parquet_Sqlserver_accountKey')]"
					},
					"LS_kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_kv_properties_typeProperties_baseUrl')]"
					},
					"LS_parquet_Sqlserver_properties_typeProperties_url": {
						"value": "[parameters('LS_parquet_Sqlserver_properties_typeProperties_url')]"
					},
					"LS_ADB_dev_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_ADB_dev_properties_typeProperties_existingClusterId')]"
					},
					"LS_onpremsqlserver_properties_typeProperties_server": {
						"value": "[parameters('LS_onpremsqlserver_properties_typeProperties_server')]"
					},
					"LS_onpremsqlserver_properties_typeProperties_database": {
						"value": "[parameters('LS_onpremsqlserver_properties_typeProperties_database')]"
					},
					"LS_onpremsqlserver_properties_typeProperties_userName": {
						"value": "[parameters('LS_onpremsqlserver_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}